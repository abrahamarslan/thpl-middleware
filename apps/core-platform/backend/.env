# ==============================================================================
# Backend local development settings (no Docker). NEVER commit this file.
# SECURITY: the Zoho client secret below was previously committed/shared —
# rotate it in the Zoho API console and paste the new value here.
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
# Logging level/format come from config/logging/environments/development.yaml.
# Uncomment to force overrides: LOG_LEVEL=DEBUG / LOG_FORMAT=console / LOG_ENABLED=true

# --- Database (async driver required) ---
DATABASE_URL=postgresql+asyncpg://app:app_password@localhost:5432/app_db

# --- Redis ---
REDIS_URL=redis://:de3IFvW5Y1GGxfRuLBuK0SgV@localhost:6379/0
