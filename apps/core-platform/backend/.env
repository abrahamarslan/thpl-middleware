CELERY_RESULT_BACKEND=redis://:de3IFvW5Y1GGxfRuLBuK0SgV@localhost:6379/3

# --- JWT ---
JWT_SECRET_KEY=mHprQIqhHzMlxLh4Qu9Uzen8bU5LDRHv8WofTLZd9JQ=

