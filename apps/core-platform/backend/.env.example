# ==============================================================================
# Backend local development settings (no Docker).
# Copy to .env and fill in real values. NEVER commit .env.
# In Docker, these values are injected by docker-compose instead.
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
# Logging level/format come from config/logging/environments/<ENVIRONMENT>.yaml.
# Optional overrides: LOG_LEVEL=DEBUG / LOG_FORMAT=console / LOG_ENABLED=true

# --- Database (async driver required) ---
DATABASE_URL=postgresql+asyncpg://app:app_password@localhost:5432/app_db

# --- Redis ---
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME@localhost:6379/2
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@localhost:6379/3

# --- JWT (generate: openssl rand -hex 32) ---
JWT_SECRET_KEY=CHANGE_ME

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Zoho Books ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3
ZOHO_ORGANIZATION_ID=

# --- Authentik Admin API (OUTBOUND user sync: app -> Authentik) ---
# Leave disabled for local dev unless you run an Authentik instance. See
# docs/AUTHENTIK_SYNC.md. For local dev the base URL is the host-published port.
AUTHENTIK_SYNC_ENABLED=false
AUTHENTIK_BASE_URL=http://localhost:9010
AUTHENTIK_SERVICE_TOKEN=

# --- Document rendering (Typst, in-process via typst-py) ---
# Slim images ship almost no fonts: bundle brand fonts and set
# TYPST_FONT_PATHS as a JSON array, e.g. '["app/assets/fonts"]'.
# TYPST_FONT_PATHS=
# TYPST_PDF_STANDARDS=
MEDIA_DIR=./media

# --- Zoho Sync Engine (fleet-wide defaults; modules override in code —
#     see docs/ZOHO_SYNC_ENGINE.md) ---
ZOHO_SYNC_BATCH_SIZE=200
ZOHO_SYNC_FULL_THRESHOLD=25000
ZOHO_SYNC_INTERVAL_MINUTES=15
ZOHO_SYNC_WAIT_BETWEEN_CALLS=0.0
ZOHO_SYNC_RETRY_LIMIT=5

# --- Zoho circuit breaker (time-based sliding window) ---
ZOHO_CB_WINDOW_SECONDS=60
ZOHO_CB_MIN_CALLS=10
ZOHO_CB_FAILURE_RATE=0.5
ZOHO_CB_SLOW_RATE=0.5
ZOHO_CB_SLOW_SECONDS=8.0
ZOHO_CB_RECOVERY_SECONDS=30

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_DEFAULT_FROM=Core Platform <noreply@example.com>
RESEND_WEBHOOK_SECRET=
EMAIL_MAX_ATTEMPTS=3

# --- MeiliSearch (query side; indexing is CDC-driven — see docs/MODULES.md) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=
SEARCH_CDC_TOPICS=zoho-mirror.public.zoho_organizations
SEARCH_CDC_GROUP_ID=meilisearch-indexer

# --- Media library storage ---
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_BASE_PATH=./media/library
MEDIA_PUBLIC_BASE_URL=/media/library

# --- Observability (off for bare-metal local dev) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
