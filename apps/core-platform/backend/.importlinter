# Import contracts â€” the platform's dependency rules
# (docs/zoho-sync-implementation/package-by-feature.md Â§3, docs/tenancy/README.md Â§8).
# Run:  .venv/bin/lint-imports      (also enforced by tests/test_import_contracts.py)
#
# Layers:
#   tenancy core   app.modules.tenants Â· organizations Â· roles (+ users) â€” everyone may depend on it
#   Zoho platform  app.modules.zoho                                    â€” entity-agnostic engine

[importlinter]
root_package = app

[importlinter:contract:zoho-platform-entity-agnostic]
name = The Zoho platform never imports a Zoho master module (they register by string)
type = forbidden
source_modules =
    app.modules.zoho
forbidden_modules =
    app.modules.taxes
    app.modules.locations
    app.modules.zoho_users
    app.modules.categories
    app.modules.brands
    app.modules.accounting
    app.modules.price_lists
    app.modules.parties

[importlinter:contract:features-never-call-zoho-directly]
name = Features never import the Zoho transport (reads = local mirror, writes = outbox)
type = forbidden
source_modules =
    app.modules.organizations
    app.modules.currencies
    app.modules.taxes
    app.modules.locations
    app.modules.zoho_users
    app.modules.categories
    app.modules.brands
    app.modules.accounting
    app.modules.price_lists
    app.modules.parties
    app.modules.resolution
    app.modules.tenants
    app.modules.roles
    app.modules.geo
forbidden_modules =
    app.modules.zoho.core.transport
    app.modules.zoho.core.client
allow_indirect_imports = True

[importlinter:contract:features-independent]
name = Zoho master modules are independent of each other (link by zoho id, not import)
type = independence
modules =
    app.modules.taxes
    app.modules.locations
    app.modules.zoho_users
    app.modules.brands
    app.modules.price_lists

# A consumer of taxes (categories carry them; items, customers, invoice lines will)
# depends on ``taxes``; ``taxes`` never depends on a consumer. That direction is what
# keeps "an entity can carry taxes" a registry row + a mixin instead of an import.
[importlinter:contract:taxes-never-import-a-consumer]
name = Taxes never imports a module that consumes it (consumers import taxes, not the reverse)
type = forbidden
source_modules =
    app.modules.taxes
forbidden_modules =
    app.modules.categories

# Accounting is a lower layer: entities that CARRY accounts (taxes today; items, contacts next)
# import ``accounting``; accounting never imports them (docs/implementation-plan/accounts-module.md §4).
[importlinter:contract:accounting-never-imports-a-consumer]
name = Accounting never imports a module that carries accounts (consumers import accounting)
type = forbidden
source_modules =
    app.modules.accounting
forbidden_modules =
    app.modules.taxes
    app.modules.categories
    app.modules.brands

# The resolution engine is feature-neutral: facets, policies and expanders REGISTER into it
# (by package name, like the Zoho adapters); it never imports them.
[importlinter:contract:resolution-engine-is-feature-neutral]
name = The resolution engine never imports a feature (features register facets into it)
type = forbidden
source_modules =
    app.modules.resolution
forbidden_modules =
    app.modules.taxes
    app.modules.accounting
    app.modules.categories
    app.modules.brands
    app.modules.currencies

[importlinter:contract:location-hub-below-masters]
name = The location hub never imports a Zoho master (locations projects INTO geo, not the reverse)
type = forbidden
source_modules =
    app.modules.geo
forbidden_modules =
    app.modules.taxes
    app.modules.locations
    app.modules.zoho_users
    app.modules.categories
    app.modules.brands

[importlinter:contract:tenancy-core-below-masters]
name = The tenancy core never imports a Zoho master module (they depend on it, not the reverse)
type = forbidden
source_modules =
    app.modules.tenants
    app.modules.organizations
    app.modules.roles
forbidden_modules =
    app.modules.taxes
    app.modules.locations
    app.modules.zoho_users
    app.modules.categories
    app.modules.brands

[importlinter:contract:sync-core-is-source-neutral]
name = The sync core never imports a source connector or a feature (the engine imports IT)
type = forbidden
source_modules =
    app.modules.sync
forbidden_modules =
    app.modules.zoho
    app.modules.organizations
    app.modules.currencies
    app.modules.taxes
    app.modules.locations
    app.modules.zoho_users
    app.modules.categories
    app.modules.brands
    app.modules.geo

# Field operations is a LEAF: it reads the location hub, users, RBAC, comments, compliance …;
# none of them may import it back (docs/fieldops/implementation-of-shift-visits-system.md §1).
# That is why /me/location moved INTO fieldops instead of users calling the ingest.
[importlinter:contract:fieldops-is-a-leaf]
name = Nothing below field operations imports it (fieldops depends on them, not the reverse)
type = forbidden
source_modules =
    app.modules.users
    app.modules.geo
    app.modules.rbac
    app.modules.roles
    app.modules.organizations
    app.modules.tenants
    app.modules.teams
    app.modules.hr
    app.modules.comments
    app.modules.compliance
    app.modules.vehicles
    app.modules.entities
    app.modules.idempotency
    app.modules.hubs
forbidden_modules =
    app.modules.fieldops

# Parties sit ABOVE the hubs they use (geo, taxes, accounting, currencies, price lists, custom fields,
# categories, media, documents, comments): those hubs never import parties. Documents that name a party
# (invoices, payments) import parties.mixins — the reverse direction is the bug this contract catches.
[importlinter:contract:hubs-never-import-parties]
name = The hubs a party uses never import the parties module
type = forbidden
source_modules =
    app.modules.geo
    app.modules.taxes
    app.modules.accounting
    app.modules.currencies
    app.modules.price_lists
    app.modules.custom_fields
    app.modules.categories
    app.modules.media
    app.modules.documents
    app.modules.comments
    app.modules.resolution
forbidden_modules =
    app.modules.parties
allow_indirect_imports = True
