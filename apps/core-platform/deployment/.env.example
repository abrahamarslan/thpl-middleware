# ==============================================================================
# Deployment environment template.
# Copy to .env and replace every CHANGE_ME. Generation commands:
#   passwords/keys:  openssl rand -hex 32
#   authentik key:   openssl rand -base64 48 | tr -d '\n'
# ==============================================================================

# --- Application ---
ENVIRONMENT=production
DEBUG=false
TZ=UTC

# --- Logging ---
# ENVIRONMENT (above) selects config/logging/environments/<env>.yaml, which
# drives level + format. The following are OPTIONAL overrides — leave unset to
# let the profile decide; set to force a value (handy for a temporary deep dive).
#   LOG_LEVEL=DEBUG          # CRITICAL|ERROR|WARNING|INFO|DEBUG
#   LOG_FORMAT=json          # json | console
#   LOG_ENABLED=true         # master switch; false silences all app logging

# --- Domain & URLs ---
APP_DOMAIN=app.local
VITE_API_URL=/api
# Absolute URL the SPA is served from — used for action links in emails.
FRONTEND_URL=https://app.local

# --- Traefik ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# --- Dev-only host ports (used by docker-compose.dev.yml) ---
FRONTEND_DEV_PORT=5174
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9001
MEILISEARCH_PORT=7700
KAFKA_EXTERNAL_PORT=19092
KAFKA_UI_PORT=8088
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
DEBEZIUM_PORT=8083
SOKETI_PORT=6001
AUTHENTIK_PORT=9010
MAILHOG_UI_PORT=8025

# --- PostgreSQL ---
POSTGRES_DB=app_db
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_VERSION=18-3.6--v2025.11.24
POSTGRES_MAJOR=18
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# --- Backups (every 2 days) ---
# Keep the cron values quoted: shell scripts source this file, and
# unquoted values with spaces break `set -a; . .env`.
POSTGRES_BACKUP_CRON="0 2 */2 * *"
POSTGRES_BACKUP_RETENTION_DAYS=14
BACKUP_CRON="0 3 */2 * *"
BACKUP_RETENTION_DAYS=14

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME
REDIS_MAX_CONNECTIONS=50

# --- ClickHouse ---
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=CHANGE_ME

# --- MeiliSearch ---
MEILISEARCH_KEY=CHANGE_ME

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# --- CORS (JSON array) ---
CORS_ORIGINS=["https://app.local"]
CORS_CREDENTIALS=true
# Tenancy: rows written without a tenant context go to this tenant (created by the migration)
DEFAULT_TENANT_CODE=default
# Platform administrators (manage tenants), comma-separated emails
PLATFORM_ADMIN_EMAILS=""

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Runtime tuning ---
PYTHON_VERSION=3.12
NODE_VERSION=22
WORKERS=4
CELERY_CONCURRENCY=4

# --- Observability ---
OTEL_ENABLED=true

# --- Soketi ---
SOKETI_APP_ID=app
SOKETI_APP_KEY=CHANGE_ME
SOKETI_APP_SECRET=CHANGE_ME

# --- Authentik OIDC (backend token validation; INBOUND) ---
AUTHENTIK_OIDC_ENABLED=false
AUTHENTIK_OIDC_ISSUER=https://auth.app.local/application/o/core-platform/
AUTHENTIK_OIDC_CLIENT_ID=
# Internal URL — containers cannot resolve auth.<domain>
AUTHENTIK_OIDC_JWKS_URL=http://authentik-server:9000/application/o/core-platform/jwks/

# --- Authentik Admin API (OUTBOUND user sync: app -> Authentik) ---
# Mirrors local users into Authentik. Requires a service-account API token with
# Core User create/change/delete + reset-password permissions. See
# docs/AUTHENTIK_SYNC.md for the one-time Authentik setup.
AUTHENTIK_SYNC_ENABLED=false
AUTHENTIK_BASE_URL=http://authentik-server:9000
AUTHENTIK_SERVICE_TOKEN=CHANGE_ME

# --- Authentik IAM ---
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=CHANGE_ME
AUTHENTIK_LOG_LEVEL=info
AUTHENTIK_EMAIL_HOST=smtp.example.com
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USE_TLS=true

# --- Kafbat UI ---
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=CHANGE_ME

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Production TLS ---
ACME_EMAIL=you@example.com
ACMEDNS_API_PORT=8053

# --- Zoho Integration ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3
ZOHO_ORGANIZATION_ID=
# Tenant owning the Zoho connection (empty = DEFAULT_TENANT_CODE)
ZOHO_TENANT_CODE=
ZOHO_CONNECTION_PROBE_AFTER_SECONDS=900
ZOHO_CONNECTION_PROBE_CACHE_SECONDS=60
# Debug only: log every Zoho request/response body (truncated). Contains business/personal data.
ZOHO_HTTP_LOG_BODIES=false
ZOHO_HTTP_LOG_BODY_MAX=2000

# --- Zoho core: OAuth + Inventory (see app/core/conf.py) ---
ZOHO_REGION=in
ZOHO_BOOKS_API_URL=https://www.zohoapis.in/books/v3
ZOHO_INVENTORY_API_URL=https://www.zohoapis.in/inventory/v1
ZOHO_API_VERSION_BOOKS=v3
ZOHO_API_VERSION_INVENTORY=v1
ZOHO_OAUTH_URL=https://accounts.zoho.in/oauth/v2/auth
ZOHO_ACCESS_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_REDIRECT_URL=https://app.local/api/zoho/auth/callback
# Where the browser lands AFTER connecting Zoho — a frontend page, NOT the callback
# above (that loops). Empty = the callback answers {"connected": true}.
ZOHO_AUTH_RETURN_URL=""
# Extra hosts ?return_url= may point to (FRONTEND_URL/callback hosts are always allowed)
ZOHO_AUTH_RETURN_HOSTS=""
ZOHO_SCOPE=ZohoBooks.fullaccess.all
ZOHO_ACCESS_TYPE=offline
ZOHO_PROMPT=Consent
ZOHO_RATE_DECAY=60
ZOHO_WEBHOOK_KEY_INCOMING=

# --- Zoho refresh-token storage (docs/zoho-sync-implementation/auth.md) ---
# Encrypted with pgcrypto in zoho_oauth_credentials. Generate a key with
#   openssl rand -base64 48
# and QUOTE it (shell scripts source this file). Losing the key = reconnect.
ZOHO_TOKEN_PERSISTENCE_ENABLED=false
ZOHO_TOKEN_ENCRYPTION_KEY=""

# --- Zoho governor (docs/zoho-sync-implementation/governor.md) ---
# Daily call ceiling (contracted limit), per-minute rate (Zoho blocks the org
# above 100/min) and org-wide concurrency for EVERY Zoho call.
ZOHO_GOVERNOR_ENABLED=true
ZOHO_CONTRACT_DAILY_LIMIT=45000
ZOHO_DAILY_HARD_LIMIT=45000
ZOHO_RATE_LIMIT_PER_MINUTE=80
ZOHO_MAX_CONCURRENT_REQUESTS=6
ZOHO_QUOTA_DAY_TIMEZONE=Asia/Kolkata
# Zoho control plane (docs/zoho-sync-implementation/control-plane.md, apply-gate.md)
# operators allowed on /api/zoho/admin (comma-separated); empty = nobody in prod
ZOHO_OPERATOR_EMAILS=""
ZOHO_PLANNER_ENABLED=true
ZOHO_PLANNER_MAX_CONCURRENT_RUNS=2
# never delete local rows because one scan missed them
ZOHO_SYNC_ALLOW_SOFT_DELETE_MISSING=false
# slice budget; keep below Celery's 540 s soft limit
ZOHO_SYNC_MAX_RUN_SECONDS=240
ZOHO_SYNC_MAX_PAGES_PER_RUN=0
ZOHO_SYNC_MAX_RECORDS_PER_RUN=0
# background lanes yield above this CDC lag
ZOHO_WRITE_PRESSURE_MAX_SLOT_LAG_MB=512
ZOHO_WRITE_PRESSURE_MAX_QUEUE_DEPTH=5000

# --- Email (Resend) — reusable transactional layer ---
# Provider adapter + template registry live in app/modules/emails/.
EMAIL_PROVIDER=resend
EMAIL_ENABLED=true
# Dev/staging: persist + mark sent WITHOUT calling the provider (no key needed).
EMAIL_LOG_ONLY=false
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_DEFAULT_FROM="Core Platform <noreply@example.com>"
RESEND_DEFAULT_REPLY_TO=
RESEND_WEBHOOK_SECRET=
EMAIL_MAX_ATTEMPTS=3
EMAIL_TIMEOUT_SECONDS=30
# Brand values injected into every template.
EMAIL_COMPANY_NAME=Tarrina Health
EMAIL_SUPPORT_EMAIL=tech@tarrinahealth.com
EMAIL_SITE_URL=https://tarrinahealth.com
EMAIL_COMPANY_ADDRESS=iHub, Gujarat Knowledge Consortium, Navrangpura — 380009, Ahmedabad, Gujarat, India

# --- GeoIP (MaxMind GeoLite2) — request audit location for auth emails/logs ---
# DB not bundled (MaxMind licensing). Download GeoLite2-City/Country.mmdb into
# deployment/config/geoip/ (git-ignored), then set GEOIP_ENABLED=true.
GEOIP_ENABLED=false
GEOIP_CITY_DB_PATH=/app/geoip/GeoLite2-City.mmdb
GEOIP_COUNTRY_DB_PATH=/app/geoip/GeoLite2-Country.mmdb

# --- Geocoding & routing (docs/geo/geocoding.md) ---
# Off by default: no deployment starts making paid third-party calls just
# because a key is present in the environment. Check GET /api/geocoding/providers.
GEOCODING_ENABLED=false
GEOCODING_PROVIDER=                  # google | mapbox | nominatim | pelias
GEOCODING_FALLBACK_PROVIDERS=        # comma-separated, tried in order
GEOCODING_DEFAULT_COUNTRY=IN         # ISO alpha-2 bias; "" = worldwide
GEOCODING_DEFAULT_LANGUAGE=en
GEOCODING_CACHE_DAYS=30              # licence ceiling (Google permits 30 for geocodes)
GEOCODING_ROUTING_CACHE_DAYS=1
GEOCODING_TIMEOUT_SECONDS=8.0
GEOCODING_CONNECT_TIMEOUT_SECONDS=3.0
GEOCODING_MAX_ATTEMPTS=3
GEOCODING_RETRY_BACKOFF_SECONDS=0.5
GEOCODING_MAX_CALLS_PER_MINUTE=60    # local spend guard; a provider's own policy still caps it
GEOCODING_CB_FAILURES=5              # consecutive failures that open the circuit
GEOCODING_CB_WINDOW_SECONDS=120
GEOCODING_CB_RECOVERY_SECONDS=60
# Provider credentials / endpoints
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
GEOCODING_MAPBOX_BASE_URL=           # "" = Geocoding v6; set a v5 URL for older accounts
GEOCODING_NOMINATIM_BASE_URL=        # "" = the public OSM instance (~1 req/s, no bulk use)
GEOCODING_NOMINATIM_USER_AGENT=      # REQUIRED by Nominatim, e.g. "th-middleware (ops@example.com)"
GEOCODING_PELIAS_BASE_URL=
GEOCODING_PELIAS_API_KEY=
# Routing. "" = straight-line distances computed in-process, no durations.
# Valhalla is a ROUTING engine and cannot geocode — pair it with Pelias above.
ROUTING_PROVIDER=                    # valhalla | google | mapbox | haversine
ROUTING_VALHALLA_BASE_URL=

# --- Password policy (app/modules/users/password_policy.py) ---
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_MIN_UNIQUE_CHARS=4
PASSWORD_DISALLOW_COMMON=true
PASSWORD_DISALLOW_USER_INFO=true

# --- Password reset (4-digit code by default) ---
# A 4-digit code is safe only because of these caps — keep the TTL short and
# the attempt limit low.
PASSWORD_RESET_CODE_LENGTH=4
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_LINK_TTL_MINUTES=60
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=5

# --- Login OTP (passwordless email OTP) ---
LOGIN_OTP_CODE_LENGTH=6
LOGIN_OTP_TTL_MINUTES=15
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_OTP_MAX_PER_HOUR=5

# --- Document rendering (Typst, in-process via typst-py) ---
# Slim images ship almost no fonts: bundle brand fonts and set JSON arrays,
# e.g. TYPST_FONT_PATHS='["app/assets/fonts"]'. Empty = system fonts.
# TYPST_FONT_PATHS=
# TYPST_PDF_STANDARDS=

# --- Search indexer (Debezium CDC topics -> Meilisearch; comma-separated) ---
SEARCH_CDC_TOPICS=zoho-mirror.org_management.organizations

# --- Paths (relative to deployment/) ---
FRONTEND_PATH=../frontend
