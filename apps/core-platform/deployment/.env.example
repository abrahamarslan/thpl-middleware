# ==============================================================================
# Deployment environment template.
# Copy to .env and replace every CHANGE_ME. Generation commands:
#   passwords/keys:  openssl rand -hex 32
#   authentik key:   openssl rand -base64 48 | tr -d '\n'
# ==============================================================================

# --- Application ---
ENVIRONMENT=production
DEBUG=false
TZ=UTC

# --- Logging ---
# ENVIRONMENT (above) selects config/logging/environments/<env>.yaml, which
# drives level + format. The following are OPTIONAL overrides — leave unset to
# let the profile decide; set to force a value (handy for a temporary deep dive).
#   LOG_LEVEL=DEBUG          # CRITICAL|ERROR|WARNING|INFO|DEBUG
#   LOG_FORMAT=json          # json | console
#   LOG_ENABLED=true         # master switch; false silences all app logging

# --- Domain & URLs ---
APP_DOMAIN=app.local
VITE_API_URL=/api

# --- Traefik ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# --- Dev-only host ports (used by docker-compose.dev.yml) ---
FRONTEND_DEV_PORT=5174
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9001
MEILISEARCH_PORT=7700
KAFKA_EXTERNAL_PORT=19092
KAFKA_UI_PORT=8088
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
DEBEZIUM_PORT=8083
SOKETI_PORT=6001
AUTHENTIK_PORT=9010
MAILHOG_UI_PORT=8025

# --- PostgreSQL ---
POSTGRES_DB=app_db
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_VERSION=18-3.6--v2025.11.24
POSTGRES_MAJOR=18
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# --- Backups (every 2 days) ---
# Keep the cron values quoted: shell scripts source this file, and
# unquoted values with spaces break `set -a; . .env`.
POSTGRES_BACKUP_CRON="0 2 */2 * *"
POSTGRES_BACKUP_RETENTION_DAYS=14
BACKUP_CRON="0 3 */2 * *"
BACKUP_RETENTION_DAYS=14

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME
REDIS_MAX_CONNECTIONS=50

# --- ClickHouse ---
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=CHANGE_ME

# --- MeiliSearch ---
MEILISEARCH_KEY=CHANGE_ME

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# --- CORS (JSON array) ---
CORS_ORIGINS=["https://app.local"]
CORS_CREDENTIALS=true

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Runtime tuning ---
PYTHON_VERSION=3.12
NODE_VERSION=22
WORKERS=4
CELERY_CONCURRENCY=4

# --- Observability ---
OTEL_ENABLED=true

# --- Soketi ---
SOKETI_APP_ID=app
SOKETI_APP_KEY=CHANGE_ME
SOKETI_APP_SECRET=CHANGE_ME

# --- Authentik OIDC (backend token validation; INBOUND) ---
AUTHENTIK_OIDC_ENABLED=false
AUTHENTIK_OIDC_ISSUER=https://auth.app.local/application/o/core-platform/
AUTHENTIK_OIDC_CLIENT_ID=
# Internal URL — containers cannot resolve auth.<domain>
AUTHENTIK_OIDC_JWKS_URL=http://authentik-server:9000/application/o/core-platform/jwks/

# --- Authentik Admin API (OUTBOUND user sync: app -> Authentik) ---
# Mirrors local users into Authentik. Requires a service-account API token with
# Core User create/change/delete + reset-password permissions. See
# docs/AUTHENTIK_SYNC.md for the one-time Authentik setup.
AUTHENTIK_SYNC_ENABLED=false
AUTHENTIK_BASE_URL=http://authentik-server:9000
AUTHENTIK_SERVICE_TOKEN=CHANGE_ME

# --- Authentik IAM ---
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=CHANGE_ME
AUTHENTIK_LOG_LEVEL=info
AUTHENTIK_EMAIL_HOST=smtp.example.com
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USE_TLS=true

# --- Kafbat UI ---
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=CHANGE_ME

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Production TLS ---
ACME_EMAIL=you@example.com
ACMEDNS_API_PORT=8053

# --- Zoho Integration ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3
ZOHO_ORGANIZATION_ID=

# --- Zoho core: OAuth + Inventory (see app/core/conf.py) ---
ZOHO_REGION=in
ZOHO_BOOKS_API_URL=https://www.zohoapis.in/books/v3
ZOHO_INVENTORY_API_URL=https://www.zohoapis.in/inventory/v1
ZOHO_API_VERSION_BOOKS=v3
ZOHO_API_VERSION_INVENTORY=v1
ZOHO_OAUTH_URL=https://accounts.zoho.in/oauth/v2/auth
ZOHO_ACCESS_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_REDIRECT_URL=http://localhost/zoho/callback
ZOHO_SCOPE=ZohoBooks.fullaccess.all
ZOHO_ACCESS_TYPE=offline
ZOHO_PROMPT=Consent
ZOHO_RATE_DECAY=60
ZOHO_WEBHOOK_KEY_INCOMING=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_DEFAULT_FROM=Core Platform <noreply@example.com>
RESEND_WEBHOOK_SECRET=

# --- Search indexer (Debezium CDC topics -> Meilisearch; comma-separated) ---
SEARCH_CDC_TOPICS=zoho-mirror.public.zoho_organizations

# --- Paths (relative to deployment/) ---
FRONTEND_PATH=../frontend
