# ==============================================================================
# PRODUCTION environment template  —  dlp.tarrinahealth.com
# ==============================================================================
# On the production VM:
#     cd ~/th-middleware/apps/core-platform/deployment
#     cp .env.prod.example .env          # <-- name it .env (see COMPOSE_FILE below)
#     chmod 600 .env
#     nano .env                          # replace every CHANGE_ME_* / <...>
#
# Then every bare command works with NO -f flags, because COMPOSE_FILE below
# tells Compose to always layer the production override:
#     docker compose up -d --build
#     docker compose exec backend alembic upgrade head
#     docker compose logs -f traefik
#     docker compose down
#
# (./manage.sh prod / prod-migrate / prod-ssl also work and do the same thing.)
#
# Secret generation (hex only — no $ & " ' to escape):
#     openssl rand -hex 24        # passwords
#     openssl rand -hex 32        # keys / tokens
#     openssl rand -hex 48        # AUTHENTIK_SECRET_KEY
# Dashboard basic-auth hash:
#     docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'PLAINTEXT'
#
# If a value must contain a literal `$`, single-quote it:  FOO='a$b'
# (otherwise Compose warns: The "b" variable is not set).
# NEVER commit the filled-in file (.env / .env.prod are git-ignored).
# ==============================================================================

# --- Compose wiring: ALWAYS include the production override -------------------
# Without this, a bare `docker compose up -d` uses ONLY docker-compose.yml — which
# has no Let's Encrypt httpChallenge and no tls.certresolver on the routers, so
# Traefik serves a self-signed cert and browsers report "not secure".
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- Application ---
ENVIRONMENT=production
DEBUG=false
TZ=Asia/Kolkata
# Swagger UI at https://<APP_DOMAIN>/api/docs. It exposes the entire API schema,
# so it stays behind HTTP basic-auth (the dashboard-auth creds) even when on.
# Set true only while you need it; set back to false afterwards.
DOCS_ENABLED=false

# --- Domain & URLs ---
APP_DOMAIN=dlp.tarrinahealth.com
API_PREFIX=/api
VITE_API_URL=/api

# --- Traefik / TLS (Let's Encrypt HTTP-01 — config/traefik/traefik.prod.yml) ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
ACME_EMAIL=tech@tarrinahealth.com
# Leave unset. Only set ACMEDNS_ENABLED=true if you switch traefik.prod.yml to
# the dnsChallenge block for wildcard certs (adds the acme-dns container on :53).
# ACMEDNS_ENABLED=false

# --- CORS (JSON array — must exactly match the browser origin) ---
CORS_ORIGINS=["https://dlp.tarrinahealth.com"]
CORS_CREDENTIALS=true

# --- PostgreSQL ---
POSTGRES_DB=app_db
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_VERSION=18-3.6--v2025.11.24
POSTGRES_MAJOR=18
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# --- Backups (keep cron values quoted) ---
POSTGRES_BACKUP_CRON="0 2 */2 * *"
POSTGRES_BACKUP_RETENTION_DAYS=14
BACKUP_CRON="0 3 */2 * *"
BACKUP_RETENTION_DAYS=14

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24
REDIS_MAX_CONNECTIONS=50

# --- ClickHouse ---
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# --- MeiliSearch ---
MEILISEARCH_KEY=CHANGE_ME_openssl_rand_hex_32

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# --- Runtime tuning ---
PYTHON_VERSION=3.12
NODE_VERSION=22
WORKERS=4
CELERY_CONCURRENCY=4
RATE_LIMIT_PER_MINUTE=120
OTEL_ENABLED=true

# --- Soketi (wss://ws.dlp.tarrinahealth.com) ---
SOKETI_APP_ID=CHANGE_ME_openssl_rand_hex_8
SOKETI_APP_KEY=CHANGE_ME_openssl_rand_hex_16
SOKETI_APP_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- Kafka ---
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
SEARCH_CDC_TOPICS=zoho-mirror.public.zoho_organizations

# --- Authentik OIDC (INBOUND — backend validates Authentik tokens) ---
# TODO after first boot: create the OAuth2 provider + application in Authentik,
#      set CLIENT_ID, then flip ENABLED to true.
AUTHENTIK_OIDC_ENABLED=false
AUTHENTIK_OIDC_ISSUER=https://auth.dlp.tarrinahealth.com/application/o/core-platform/
AUTHENTIK_OIDC_CLIENT_ID=
AUTHENTIK_OIDC_JWKS_URL=http://authentik-server:9000/application/o/core-platform/jwks/

# --- Authentik Admin API (OUTBOUND — mirror local users into Authentik) ---
# TODO: create a service-account token in Authentik (Directory -> Tokens), then
#       paste it and set ENABLED=true. It is NOT a random value.
AUTHENTIK_SYNC_ENABLED=false
AUTHENTIK_BASE_URL=http://authentik-server:9000
AUTHENTIK_SERVICE_TOKEN=

# --- Authentik IAM ---
AUTHENTIK_SECRET_KEY=CHANGE_ME_openssl_rand_hex_48
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=CHANGE_ME_openssl_rand_hex_24
AUTHENTIK_LOG_LEVEL=info
# First-run admin (akadmin) — applied once on the first migration.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@tarrinahealth.com
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_openssl_rand_hex_24
AUTHENTIK_BOOTSTRAP_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Authenticated outbound SMTP (Resend SMTP shown; use your provider).
AUTHENTIK_EMAIL_HOST=smtp.resend.com
AUTHENTIK_EMAIL_PORT=587
AUTHENTIK_EMAIL_USERNAME=resend
AUTHENTIK_EMAIL_PASSWORD=
AUTHENTIK_EMAIL_USE_TLS=true
AUTHENTIK_EMAIL_USE_SSL=false
AUTHENTIK_EMAIL_FROM="Tarrina Health <noreply@tarrinahealth.com>"

# --- Kafbat UI (bound to VM loopback; reach via SSH tunnel) ---
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# --- Grafana (https://dlp.tarrinahealth.com/grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# --- Zoho Integration (India DC) ---
# TODO: rotate the client secret in api-console.zoho.in — the dev value is in git.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3
ZOHO_REGION=in
ZOHO_BOOKS_API_URL=https://www.zohoapis.in/books/v3
ZOHO_INVENTORY_API_URL=https://www.zohoapis.in/inventory/v1
ZOHO_OAUTH_URL=https://accounts.zoho.in/oauth/v2/auth
ZOHO_ACCESS_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_REDIRECT_URL=https://dlp.tarrinahealth.com/api/zoho/auth/callback
ZOHO_SCOPE=ZohoBooks.fullaccess.all
ZOHO_ACCESS_TYPE=offline
ZOHO_PROMPT=Consent
ZOHO_AUTH_REQUIRE_USER=true
ZOHO_CALLBACK_REQUIRE_USER=false
ZOHO_RATE_DECAY=60
ZOHO_WEBHOOK_KEY_INCOMING=

# --- Email (Resend — transactional email from the app) ---
RESEND_API_KEY=
RESEND_DEFAULT_FROM="Tarrina Health <noreply@tarrinahealth.com>"
RESEND_WEBHOOK_SECRET=

# --- Email layer (brand + delivery switches; see docs/modules/email-module-documentation.md) ---
EMAIL_PROVIDER=resend
EMAIL_ENABLED=true
EMAIL_LOG_ONLY=false
EMAIL_MAX_ATTEMPTS=3
EMAIL_TIMEOUT_SECONDS=30
EMAIL_COMPANY_NAME=Tarrina Health
EMAIL_SUPPORT_EMAIL=tech@tarrinahealth.com
EMAIL_SITE_URL=https://tarrinahealth.com
# Values with spaces MUST be quoted — deployment shell scripts source this file.
EMAIL_COMPANY_ADDRESS="iHub, Gujarat Knowledge Consortium, Navrangpura — 380009, Ahmedabad, Gujarat, India"
# Absolute SPA URL used in email action links (reset password / dashboard).
FRONTEND_URL=https://dlp.tarrinahealth.com

# --- GeoIP (MaxMind GeoLite2) — mount config/geoip/ read-only at /app/geoip ---
# The .mmdb files are git-ignored; copy them to the VM (see the deployment guide).
GEOIP_ENABLED=true
GEOIP_CITY_DB_PATH=/app/geoip/GeoLite2-City.mmdb
GEOIP_COUNTRY_DB_PATH=/app/geoip/GeoLite2-Country.mmdb

# --- Password reset (4-digit code by default) ---
PASSWORD_RESET_CODE_LENGTH=4
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_LINK_TTL_MINUTES=60
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=5

# --- Login OTP (passwordless email OTP) ---
LOGIN_OTP_CODE_LENGTH=6
LOGIN_OTP_TTL_MINUTES=15
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_OTP_MAX_PER_HOUR=5

# --- Password policy (optional; sensible defaults live in code) ---
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MAX_LENGTH=128
# PASSWORD_REQUIRE_UPPERCASE=true
# PASSWORD_REQUIRE_LOWERCASE=true
# PASSWORD_REQUIRE_DIGIT=true
# PASSWORD_REQUIRE_SPECIAL=false
# PASSWORD_MIN_UNIQUE_CHARS=4
# PASSWORD_DISALLOW_COMMON=true
# PASSWORD_DISALLOW_USER_INFO=true
# PASSWORD_RESET_HMAC_KEY=   # optional dedicated key; falls back to JWT_SECRET_KEY

# --- Document rendering (Typst) — empty = system fonts ---
# TYPST_FONT_PATHS=["app/assets/fonts"]

# --- Paths (relative to deployment/) ---
FRONTEND_PATH=../frontend
