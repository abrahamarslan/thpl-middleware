{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "${POSTGRES_USER}",
  "database.password": "${POSTGRES_PASSWORD}",
  "database.dbname": "${POSTGRES_DB}",
  "topic.prefix": "zoho-mirror",
  "plugin.name": "pgoutput",
  "slot.name": "zoho_mirror",
  "publication.autocreate.mode": "filtered",
  "table.include.list": "public.zoho_contacts,public.zoho_items,org_management.tenants,org_management.organizations,public.roles,public.zoho_currencies,public.zoho_taxes,public.zoho_locations,public.zoho_users,public.zoho_sync_stats,public.zoho_queue_logs,public.email_events,public.email_links,core.brands,core.manufacturers,public.hubs,public.fleet_partners,public.vehicles,public.vehicle_compliance_documents,public.driving_licenses,public.user_live_locations,public.user_location_pings,public.kyc_profiles,public.background_verifications,public.consent_records,public.employment_records,public.bank_accounts",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "false",
  "decimal.handling.mode": "double",
  "time.precision.mode": "adaptive_time_microseconds",
  "heartbeat.interval.ms": "30000",
  "transforms": "unwrap",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.drop.tombstones": "true",
  "transforms.unwrap.delete.handling.mode": "rewrite",
  "transforms.unwrap.add.fields": "op,source.ts_ms"
}
