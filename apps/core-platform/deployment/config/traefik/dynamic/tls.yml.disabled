# ==============================================================================
# Development TLS — mkcert certificates (generated by scripts/setup-ssl.sh)
# Production uses the letsencrypt certresolver instead; this file is then
# harmless (Traefik ignores missing default cert files at the router level
# when a resolver is set on the router).
# ==============================================================================

tls:
  certificates:
    - certFile: /etc/traefik/certs/local.pem
      keyFile: /etc/traefik/certs/local-key.pem
  stores:
    default:
      defaultCertificate:
        certFile: /etc/traefik/certs/local.pem
        keyFile: /etc/traefik/certs/local-key.pem
